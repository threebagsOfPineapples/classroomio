  "components": [
    {
      "name": "主要操作",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "普通主要操作为深橙白字；下一步学习面板使用其浅橙墨字局部覆写。",
      "html": "<a class=\"ds-primary\" href=\"#primary\">查看课程</a> <a class=\"ds-primary ds-next-primary\" href=\"#continue\">继续学习</a>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;background:var(--primary,#bd4b00);color:var(--primary-foreground,#fff);border-radius:calc(var(--radius,0.625rem) - 2px);padding:8px 16px;height:36px;font-size:14px;font-weight:500;text-decoration:none;white-space:nowrap;transition:all 150ms cubic-bezier(0.4,0,0.2,1);box-shadow:var(--ui-shadow-2xs,0 1px rgb(0 0 0 / 0.05))}.ds-primary:hover{background:color-mix(in oklab,var(--primary,#bd4b00) 90%,transparent)}.ds-primary:focus-visible{outline:2px solid var(--primary,#bd4b00);outline-offset:3px;box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,#bd4b00) 50%,transparent)}.ds-next-primary{--primary:#ffad49;--primary-foreground:#19283d}"
    },
    {
      "name": "次要操作",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "共享 Button 的 secondary 链接变体，保留中性表面。",
      "html": "<a class=\"ds-secondary\" href=\"#secondary\">查看详情</a>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;background:var(--secondary,#f0f3f7);color:var(--secondary-foreground,#28384c);border-radius:calc(var(--radius,0.625rem) - 2px);padding:8px 16px;height:36px;font-size:14px;font-weight:500;text-decoration:none;transition:all 150ms cubic-bezier(0.4,0,0.2,1);box-shadow:var(--ui-shadow-2xs,0 1px rgb(0 0 0 / 0.05))}.ds-secondary:hover{background:color-mix(in oklab,var(--secondary,#f0f3f7) 80%,transparent)}.ds-secondary:focus-visible{outline:2px solid var(--primary,#bd4b00);outline-offset:3px;box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,#bd4b00) 50%,transparent)}"
    },
    {
      "name": "文本输入",
      "kind": "input",
      "refersTo": "input",
      "description": "共享 Search/Input 的现有视觉；课程状态筛选与搜索结合，清空关键词保留当前分类，查看全部同时重置。",
      "html": "<input class=\"ds-input\" type=\"text\" aria-label=\"课程名称\" placeholder=\"课程名称\" />",
      "css": ".ds-input{height:36px;min-width:0;border:1px solid var(--input,#d9e0e9);background:var(--background,oklch(1 0 0));color:var(--foreground,#202c3d);border-radius:calc(var(--radius,0.625rem) - 2px);padding:4px 12px;font-size:16px;transition:color 150ms cubic-bezier(0.4,0,0.2,1),box-shadow 150ms cubic-bezier(0.4,0,0.2,1);box-shadow:var(--ui-shadow-xs,0 1px 2px 0 rgb(0 0 0 / 0.05))}.ds-input::placeholder{color:var(--muted-foreground,#617083)}.ds-input:focus-visible{border-color:var(--ring,#bd4b00);outline:2px solid var(--primary,#bd4b00);outline-offset:3px;box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,#bd4b00) 50%,transparent)}.ds-input[aria-invalid=true]{border-color:var(--destructive,oklch(0.577 0.245 27.325))}.ds-input:disabled{cursor:not-allowed;opacity:.5}@media(min-width:768px){.ds-input{font-size:14px}}"
    },
    {
      "name": "培训面板",
      "kind": "card",
      "refersTo": "training-panel",
      "description": "白色培训面板与白色个人四项概览；下一步学习另用深蓝行动面板，不将个人指标放入深蓝区域。",
      "html": "<section class=\"ds-panel\"><strong>我的学习概览</strong><div class=\"ds-personal-metrics\"><p>待完成课程<strong>—</strong></p><p>已完成课程<strong>—</strong></p><p>平均成绩<strong>—</strong></p><p>实际学习时长<strong>—</strong></p></div></section>",
      "css": ".ds-panel{padding:24px;background:var(--training-paper,#ffffff);border:1px solid var(--training-line,#e2e7ee);border-radius:12px;color:var(--foreground,#202c3d);font-family:\"Microsoft YaHei\",\"PingFang SC\",sans-serif}.ds-personal-metrics{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}.ds-personal-metrics p{color:var(--training-muted,#617083);font-size:12px;font-variant-numeric:tabular-nums}.ds-personal-metrics strong{display:block;margin-top:10px;color:var(--foreground,#202c3d);font-size:30px;font-weight:600;line-height:1.2}@media(max-width:899px) and (min-width:768px){.ds-personal-metrics{grid-template-columns:repeat(4,minmax(0,1fr))}}@media(max-width:767px){.ds-panel{padding:16px}.ds-personal-metrics{gap:20px 16px}.ds-personal-metrics strong{font-size:26px;margin-top:6px}}"
    },
    {
      "name": "管理导航选中项",
      "kind": "nav",
      "refersTo": "admin-navigation-active",
      "description": "EnterpriseSidebar 与 OrgSidebar 在根组件携带墨色主题；选中项为墨蓝底、橙色字，手机portal迁移后保持。",
      "html": "<nav class=\"ds-admin-surface\" aria-label=\"管理导航\"><a class=\"ds-admin-nav\" href=\"#admin\" aria-current=\"page\">培训工作台</a></nav>",
      "css": ".ds-admin-surface{--sidebar:#17243a;--sidebar-foreground:#d5deeb;--sidebar-accent:#2b3850;--sidebar-accent-foreground:#ffb449;background:var(--sidebar);color:var(--sidebar-foreground)}.ds-admin-nav{display:flex;align-items:center;min-height:44px;padding:8px;font-size:14px;font-weight:600;border-radius:calc(var(--radius,0.625rem) - 2px);background:var(--sidebar-accent);color:var(--sidebar-accent-foreground);text-decoration:none}.ds-admin-nav:hover{background:var(--sidebar-accent)}.ds-admin-nav:focus-visible{outline:2px solid var(--primary,#bd4b00);outline-offset:3px}"
    },
    {
      "name": "学员顶部导航",
      "kind": "nav",
      "refersTo": "learner-navigation-active",
      "description": "学员导航现有橙色文字和底部线，可水平滚动。",
      "html": "<nav class=\"ds-learner-nav\" aria-label=\"学员导航\"><a href=\"#courses\" aria-current=\"page\">课程中心</a><a href=\"#training\">我的培训</a></nav>",
      "css": ".ds-learner-nav{display:flex;gap:32px;overflow-x:auto;scrollbar-width:none}.ds-learner-nav a{flex-shrink:0;padding:14px 0;border-bottom:2px solid transparent;font-size:14px;color:var(--training-muted,#617083);text-decoration:none;white-space:nowrap}.ds-learner-nav a:hover,.ds-learner-nav a[aria-current=page]{color:var(--primary,#bd4b00)}.ds-learner-nav a[aria-current=page]{border-bottom-color:var(--primary,#bd4b00);font-weight:600}.ds-learner-nav a:focus-visible{outline:2px solid var(--primary,#bd4b00);outline-offset:3px}@media(max-width:767px){.ds-learner-nav{gap:24px}}"
    },
    {
      "name": "中性状态标签",
      "kind": "chip",
      "description": "共享 Badge 的 outline 变体，保留文字标签。",
      "html": "<span class=\"ds-badge\">待完成</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;justify-content:center;width:fit-content;gap:4px;padding:2px 8px;border:1px solid var(--border,#e2e7ee);border-radius:9999px;color:var(--foreground,#202c3d);font-size:12px;font-weight:500;white-space:nowrap;transition:color 150ms cubic-bezier(0.4,0,0.2,1),box-shadow 150ms cubic-bezier(0.4,0,0.2,1)}.ds-badge:focus-visible{outline:2px solid var(--primary,#bd4b00);outline-offset:3px}"
    },
    {
      "name": "学习进度",
      "kind": "custom",
      "refersTo": "progress",
      "description": "共享 Progress 在培训课程卡片内使用分隔线灰轨道、深橙指示条；示例值仅演示视觉。",
      "html": "<div class=\"ds-progress\" role=\"progressbar\" aria-label=\"示例学习进度\" aria-valuenow=\"60\" aria-valuemin=\"0\" aria-valuemax=\"100\"><div class=\"ds-progress-indicator\"></div></div>",
      "css": ".ds-progress{position:relative;width:100%;height:8px;overflow:hidden;border-radius:calc(var(--radius,0.625rem) - 2px);background:var(--training-line,#e2e7ee)}.ds-progress-indicator{height:100%;width:100%;background:var(--primary,#bd4b00);transform:translateX(-40%);transition:all 150ms cubic-bezier(0.4,0,0.2,1)}"
    },
    {
      "name": "下一步学习行动区",
      "kind": "custom",
      "refersTo": "learner-next",
      "description": "V2真实课程行动区；标题与行动由已有学习状态决定，此预览仅示意视觉结构。",
      "html": "<section class=\"ds-next\"><div class=\"ds-next-copy\"><h2>下一步学习</h2><h3>课程标题</h3><p>按实际学习状态继续课程</p><a class=\"ds-next-cta\" href=\"#course\">继续学习</a></div><svg class=\"ds-next-art\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 7v14\"/><path d=\"M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 0 0 0-3-3z\"/></svg></section>",
      "css": ".ds-next{display:flex;align-items:center;justify-content:space-between;min-height:246px;padding:28px;border:1px solid #19283d;border-radius:12px;background:#19283d;color:#fff;font-family:\"Microsoft YaHei\",\"PingFang SC\",sans-serif}.ds-next-copy{min-width:0}.ds-next h2{font-size:18px;font-weight:600}.ds-next h3{margin:14px 0 0;font-size:26px;font-weight:600;overflow-wrap:anywhere}.ds-next p{margin-top:8px;color:#b9c7d9;font-size:13px;line-height:1.7}.ds-next-cta{display:inline-flex;align-items:center;justify-content:center;margin-top:24px;height:36px;padding:8px 16px;border-radius:calc(var(--radius,0.625rem) - 2px);background:#ffad49;color:#19283d;font-size:14px;font-weight:500;text-decoration:none;transition:all 150ms cubic-bezier(0.4,0,0.2,1)}.ds-next-cta:hover{background:color-mix(in oklab,#ffad49 90%,transparent)}.ds-next-cta:focus-visible{outline:2px solid var(--primary,#bd4b00);outline-offset:3px}.ds-next-art{width:128px;height:128px;flex-shrink:0;margin-inline:20px 10px;color:#b9c7d9;stroke-width:1}@media(max-width:1199px){.ds-next-art{display:none}}@media(max-width:899px){.ds-next{min-height:220px}}@media(max-width:767px){.ds-next{padding:22px}.ds-next h3{font-size:23px}}"
    },
    {
      "name": "课程类型无图封面",
      "kind": "card",
      "refersTo": "course-cover",
      "description": "136px统一媒体，仅复现源码中的SELF_PACED、COMPLIANCE、LIVE_CLASS类型和已有Lucide图标；真实照片继续保留。",
      "html": "<div class=\"ds-cover\" data-course-type=\"SELF_PACED\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2\"/><circle cx=\"12\" cy=\"7\" r=\"4\"/></svg></div><div class=\"ds-cover\" data-course-type=\"COMPLIANCE\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"/><path d=\"m9 12 2 2 4-4\"/></svg></div><div class=\"ds-cover\" data-course-type=\"LIVE_CLASS\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><circle cx=\"12\" cy=\"12\" r=\"1\"/></svg></div>",
      "css": ".ds-cover{display:grid;place-items:center;width:100%;height:136px;border-radius:8px;background:#e6edf5;color:#4b6a93}.ds-cover[data-course-type=COMPLIANCE]{background:#e6eeea;color:#507667}.ds-cover[data-course-type=LIVE_CLASS]{background:#f6e8d9;color:#955b2a}.ds-cover svg{width:64px;height:64px;stroke-width:1.2}"
    }
  ],
  "narrative": {
    "northStar": "清晰的企业培训工作台",
    "overview": "V2 沿用已确认的 PlayEdu 双端结构与企业橙色，分别突出下一步学习和管理待办。河南至臻数字生活科技有限公司的名称与图标由页面导航承载；学员首页的深蓝区域用于一项学习行动，个人四项指标回到白色面板。管理端保留深蓝侧栏、白色顶部栏和培训计划表格，四项指标分别成卡。\n\n课程封面减少重复信息：真实照片保留，无图课程仅用实际课程类型的既有 Lucide 图标与中性底色，标题在卡片正文显示。课程默认查看待完成集合，并明确未开始、学习中和已完成。中文界面优先，作者原有英文内容保留，AI 默认隐藏；复用现有共享组件，没有新增框架、图表、假趋势或排行榜。",
    "keyCharacteristics": [
      "橙色主操作、深蓝导航与学习行动区、冷灰背景、白色指标面板。",
      "学员首页行动区与四项个人概览，课程区域与前置待办。",
      "管理端四张独立指标卡、计划表、去重评分队列和部门进度。",
      "无图封面仅显示实际课程类型图标，照片和占位媒体统一高度。",
      "未知、真实零、加载、失败重试、空结果与权限不足分别呈现。"
    ],
    "rules": [
      {
        "name": "The Action Color Rule",
        "body": "深蓝区域承载下一步学习，个人统计使用白色面板；普通主要操作使用深橙白字，学习行动区使用其已有浅橙墨字覆写。",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** 让深蓝行动区突出一项真实下一步学习，个人四项指标使用白色面板。",
      "**Do** 保留课程默认待完成和状态对应行动；100% 内容进度与合规完成分开。",
      "**Do** 保留真实照片，无图时仅用实际类型图标与中性底色。",
      "**Do** 保留去重评分总数、权限判断、部门完成/分配基数和独立失败重试。",
      "**Do** 让小于 900px 的首页待办排在课程前，手机课程单列、指标双列。"
    ],
    "donts": [
      "**Don't** 恢复标题与公司 Logo 叠加的课程无图封面或旧高度。",
      "**Don't** 把已完成课程继续标为继续学习，或将内容进度直接等同培训结业。",
      "**Don't** 在首页开始考试，或仅凭时间窗口声称考试次数和资格可用。",
      "**Don't** 将未知、失败或无权限呈现为真实零，也不编造趋势与能力排名。",
      "**Don't** 将原型或尚未完成的复验描述成生产上线或全量业务验收。"
    ]
  }
}
