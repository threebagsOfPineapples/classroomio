  "components": [
    {
      "name": "主要操作",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "共享 Button 的默认主要操作为深橙白字；学习概览继续学习使用品牌橙墨字的已有局部覆写。",
      "html": "<a class=\"ds-primary\" href=\"#primary\">查看课程</a> <a class=\"ds-primary ds-overview-primary\" href=\"#continue\">继续学习</a>",
      "css": ".ds-primary{display:inline-flex;align-items:center;justify-content:center;background:var(--primary,#bd4b00);color:var(--primary-foreground,#fff);border-radius:calc(var(--radius,0.625rem) - 2px);padding:8px 16px;height:36px;font-size:14px;font-weight:500;text-decoration:none;white-space:nowrap;transition:all 150ms cubic-bezier(0.4,0,0.2,1);box-shadow:var(--ui-shadow-2xs,0 1px rgb(0 0 0 / 0.05))}.ds-primary:hover{background:color-mix(in oklab,var(--primary,#bd4b00) 90%,transparent)}.ds-primary:focus-visible{outline:2px solid var(--primary,#bd4b00);outline-offset:3px;box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,#bd4b00) 50%,transparent)}.ds-overview-primary{--primary:#f59a18;--primary-foreground:#17243a;height:32px;padding:0 12px}"
    },
    {
      "name": "次要操作",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "共享 Button 的 secondary 链接变体，保留中性表面。",
      "html": "<a class=\"ds-secondary\" href=\"#secondary\">查看详情</a>",
      "css": ".ds-secondary{display:inline-flex;align-items:center;justify-content:center;background:var(--secondary,#f0f3f7);color:var(--secondary-foreground,#28384c);border-radius:calc(var(--radius,0.625rem) - 2px);padding:8px 16px;height:36px;font-size:14px;font-weight:500;text-decoration:none;transition:all 150ms cubic-bezier(0.4,0,0.2,1);box-shadow:var(--ui-shadow-2xs,0 1px rgb(0 0 0 / 0.05))}.ds-secondary:hover{background:color-mix(in oklab,var(--secondary,#f0f3f7) 80%,transparent)}.ds-secondary:focus-visible{outline:2px solid var(--primary,#bd4b00);outline-offset:3px;box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,#bd4b00) 50%,transparent)}"
    },
    {
      "name": "文本输入",
      "kind": "input",
      "refersTo": "input",
      "description": "共享 Input 沿用培训外壳的冷灰边框和墨色文字；课程查询随输入过滤，清空恢复原列表。",
      "html": "<input class=\"ds-input\" type=\"text\" aria-label=\"课程名称\" placeholder=\"课程名称\" />",
      "css": ".ds-input{height:36px;min-width:0;border:1px solid var(--input,#d9e0e9);background:var(--background,oklch(1 0 0));color:var(--foreground,#202c3d);border-radius:calc(var(--radius,0.625rem) - 2px);padding:4px 12px;font-size:16px;transition:color 150ms cubic-bezier(0.4,0,0.2,1),box-shadow 150ms cubic-bezier(0.4,0,0.2,1);box-shadow:var(--ui-shadow-xs,0 1px 2px 0 rgb(0 0 0 / 0.05))}.ds-input::placeholder{color:var(--muted-foreground,#617083)}.ds-input:focus-visible{border-color:var(--ring,#bd4b00);outline:2px solid var(--primary,#bd4b00);outline-offset:3px;box-shadow:0 0 0 3px color-mix(in oklab,var(--ring,#bd4b00) 50%,transparent)}.ds-input[aria-invalid=true]{border-color:var(--destructive,oklch(0.577 0.245 27.325))}.ds-input:disabled{cursor:not-allowed;opacity:.5}@media(min-width:768px){.ds-input{font-size:14px}}"
    },
    {
      "name": "培训面板",
      "kind": "card",
      "refersTo": "training-panel",
      "description": "普通培训面板为白色细边框；学习概览使用同一面板的墨色覆写，根圆角均为12px。",
      "html": "<section class=\"ds-panel\"><strong>培训任务</strong><p>查看已分配的培训计划</p></section><section class=\"ds-panel ds-overview\"><strong>学习概览</strong><p>平均成绩</p><strong class=\"ds-overview-metric\">—</strong></section>",
      "css": ".ds-panel{padding:24px;background:var(--training-paper,#ffffff);border:1px solid var(--training-line,#e2e7ee);border-radius:12px;color:var(--foreground,#202c3d);font-family:\"Microsoft YaHei\",\"PingFang SC\",sans-serif}.ds-panel p{color:var(--training-muted,#617083)}@media(max-width:767px){.ds-panel{padding:16px}}.ds-overview{padding:22px 24px;background:#202e44;border:0;color:#f7f9fc}.ds-overview p{color:#bfccdc}.ds-overview-metric{display:block;color:#fff;font-size:28px;font-weight:600;line-height:1.2}@media(max-width:767px){.ds-overview{padding:16px}.ds-overview-metric{font-size:26px}}"
    },
    {
      "name": "管理导航选中项",
      "kind": "nav",
      "refersTo": "admin-navigation-active",
      "description": "EnterpriseSidebar 与 OrgSidebar 在根组件携带墨色主题；选中项为墨蓝底、橙色字，手机portal迁移后保持。",
      "html": "<nav class=\"ds-admin-surface\" aria-label=\"管理导航\"><a class=\"ds-admin-nav\" href=\"#admin\" aria-current=\"page\">培训工作台</a></nav>",
      "css": ".ds-admin-surface{--sidebar:#17243a;--sidebar-foreground:#d5deeb;--sidebar-accent:#2b3850;--sidebar-accent-foreground:#ffb449;background:var(--sidebar);color:var(--sidebar-foreground)}.ds-admin-nav{display:flex;align-items:center;min-height:44px;padding:8px;font-size:14px;font-weight:600;border-radius:calc(var(--radius,0.625rem) - 2px);background:var(--sidebar-accent);color:var(--sidebar-accent-foreground);text-decoration:none}.ds-admin-nav:hover{background:var(--sidebar-accent)}.ds-admin-nav:focus-visible{outline:2px solid var(--primary,#bd4b00);outline-offset:3px}"
    },
    {
      "name": "学员顶部导航",
      "kind": "nav",
      "refersTo": "learner-navigation-active",
      "description": "学员导航现有橙色文字和底部线，可水平滚动。",
      "html": "<nav class=\"ds-learner-nav\" aria-label=\"学员导航\"><a href=\"#courses\" aria-current=\"page\">课程中心</a><a href=\"#training\">我的培训</a></nav>",
      "css": ".ds-learner-nav{display:flex;gap:32px;overflow-x:auto;scrollbar-width:none}.ds-learner-nav a{flex-shrink:0;padding:14px 0;border-bottom:2px solid transparent;font-size:14px;color:var(--training-muted,#617083);text-decoration:none;white-space:nowrap}.ds-learner-nav a:hover,.ds-learner-nav a[aria-current=page]{color:var(--primary,#bd4b00)}.ds-learner-nav a[aria-current=page]{border-bottom-color:var(--primary,#bd4b00);font-weight:600}.ds-learner-nav a:focus-visible{outline:2px solid var(--primary,#bd4b00);outline-offset:3px}@media(max-width:767px){.ds-learner-nav{gap:24px}}"
    },
    {
      "name": "中性状态标签",
      "kind": "chip",
      "description": "共享 Badge 的 outline 变体，保留文字标签。",
      "html": "<span class=\"ds-badge\">待完成</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;justify-content:center;width:fit-content;gap:4px;padding:2px 8px;border:1px solid var(--border,#e2e7ee);border-radius:9999px;color:var(--foreground,#202c3d);font-size:12px;font-weight:500;white-space:nowrap;transition:color 150ms cubic-bezier(0.4,0,0.2,1),box-shadow 150ms cubic-bezier(0.4,0,0.2,1)}.ds-badge:focus-visible{outline:2px solid var(--primary,#bd4b00);outline-offset:3px}"
    },
    {
      "name": "学习进度",
      "kind": "custom",
      "refersTo": "progress",
      "description": "共享 Progress 在培训课程卡片内使用分隔线灰轨道、深橙指示条；示例值仅演示视觉。",
      "html": "<div class=\"ds-progress\" role=\"progressbar\" aria-label=\"示例学习进度\" aria-valuenow=\"60\" aria-valuemin=\"0\" aria-valuemax=\"100\"><div class=\"ds-progress-indicator\"></div></div>",
      "css": ".ds-progress{position:relative;width:100%;height:8px;overflow:hidden;border-radius:calc(var(--radius,0.625rem) - 2px);background:var(--training-line,#e2e7ee)}.ds-progress-indicator{height:100%;width:100%;background:var(--primary,#bd4b00);transform:translateX(-40%);transition:all 150ms cubic-bezier(0.4,0,0.2,1)}"
    }
  ],
  "narrative": {
    "northStar": "清晰的企业培训工作台",
    "overview": "这份文档记录现有 PlayEdu 参考结构的配色和密度强化。河南至臻数字生活科技有限公司的企业图标与橙色品牌保持一致，管理端使用墨色侧栏、白色顶部栏与任务表格，学员端使用白色顶部导航、墨色学习概览和冷灰课程封面。页面底色与内容面板通过冷灰、白色和细边框建立层次。\n\n首屏承载管理任务或学员学习概览与课程。用户从侧栏或顶部导航进入课程、培训和档案；课程查询随输入实时过滤，清空即恢复列表。中文优先，AI 默认隐藏，控件继续沿用现有共享库；这次强化没有引入新的图片、图标组件或装饰动画。",
    "keyCharacteristics": [
      "墨色导航与学习概览、冷灰页面、白色面板、公司品牌橙色。",
      "管理端任务表格与学员端学习指标、课程卡片。",
      "真实课程标题与公司标识组成无图封面，已有课程照片保留。",
      "桌面与手机沿用同一主题，手机指标双列、课程单列。",
      "实际样式来源为 `src/training.css`，共享组件沿用 `../../packages/ui/src`。"
    ],
    "rules": [
      {
        "name": "The Brand Color Rule",
        "body": "普通主要操作使用深橙与白字；学习概览中的继续学习使用品牌橙与墨字；管理选中项使用墨色底与橙色文字。",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** 保留墨色侧栏、冷灰表面、白色面板与公司品牌橙的现有分工。",
      "**Do** 在管理侧栏根组件保留主题，使手机 portal 中的导航继续使用同一配色。",
      "**Do** 保留真实课程图片；无图时使用公司标识和真实完整标题。",
      "**Do** 保留课程实时过滤、清空恢复与真实学习指标。",
      "**Do** 在桌面与手机保留同一主题，并使用手机双列指标、单列课程。"
    ],
    "donts": [
      "**Don't** 将这次配色强化变成新的概念、动画、图片或图标组件提案。",
      "**Don't** 恢复大号两字课程封面或卡片固定窄宽度。",
      "**Don't** 默认显示 AI 入口或第三方 SDK 默认悬浮入口。",
      "**Don't** 将第三方 SDK 的配置与受信 CSS 域处理描述成公司新功能。"
    ]
  }
}
